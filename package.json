{
  "name": "wxt-svelte-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "2.3.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:beta": "wxt build -b firefox --mv2 --mode beta",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.3",
    "@wxt-dev/module-svelte": "^2.0.4",
    "jsdom": "^30.0.1",
    "sass-embedded": "^1.97.1",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.32",
    "bits-ui": "^2.14.4",
    "dompurify": "^3.3.1",
    "onnxruntime-web": "1.30.0",
    "phosphor-svelte": "^3.0.1",
    "tailwindcss": "^4.1.18"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.7": true,
    "spawn-sync@1.0.15": true
  }
}
